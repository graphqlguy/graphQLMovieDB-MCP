

scalar DateTime
scalar CountryCode

directive @Range(min: Int = 0, max: Int = 2147483647, message: String = "graphql.validation.Range.message") on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @Size(min: Int = 0, max: Int = 2147483647, message: String = "graphql.validation.Size.message") on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @Pattern(regexp: String!, message: String = "graphql.validation.Pattern.message") on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

# The single entry point of our API. This line is a comment, by the way:
# comments start with # and are only for people reading this file.
type Query {
    moviesAll: [Movie!]! @deprecated(reason: "Unbounded. Use 'movies' instead.")
    movie(id: ID!): Movie
    movies(filter: MovieFilter, page: Int = 0 @Range(min: 0), size: Int = 10 @Range(min: 1, max: 100), sort: MovieSort): MoviePage!
    moviesByIds(ids: [ID!]!): [Movie]
    searchMovies(title: String!): [Movie!]! @deprecated(reason: "Use 'search' instead.")
    people(page: Int = 0 @Range(min: 0), size: Int = 20 @Range(min: 1, max: 100)): PersonPage!
    person(id: ID!): Person
    searchPeople(name: String!): [Person!]! @deprecated(reason: "Use 'search' instead.")
    search(query: String!): [SearchResult!]!
    """Look up a country by its ISO 3166-1 alpha-2 code, e.g. CZ"""
    country(code: ID!): Country
    """Search TMDB (The Movie Database) for movies by title"""
    tmdbSearch(title: String!): [TmdbResult!]!
    tvShow(id: ID!): TvShow
    tvShows(page: Int = 0 @Range(min: 0), size: Int = 10 @Range(min: 1, max: 100)): TvShowPage!
    """The signed-in user's watch list."""
    watchlist: [WatchlistItem!]!

    """
    Recommends up to ten movies that fit a given mood for the current user,
    if authenticated; the operation also works for anonymous callers.
    Suitable for low-stakes recommendation flows ("I want something fun tonight")
    where the user benefits from a curated suggestion instead of an exhaustive
    search. Results are ranked by rating, highest first, with a stable tiebreak
    on id, so repeated calls return the same order. Returns an empty list
    (never null) when the catalog does not contain any matches for the mood;
    an empty list is a valid answer, not a failure.
    """
    recommendMoviesForMood(
        """
        The mood to recommend for. Required. The set is bounded by design;
        if the desired mood is not in the list, the agent should pick the
        closest available value rather than supplying a free-text hint.
        """
        mood: Mood!,
        """
        When true, omits any movie the authenticated user has marked WATCHED
        on their watch list. Defaults to false. For anonymous callers the flag
        is a no-op: there is no watch list to exclude against, and the
        operation succeeds rather than failing.
        """
        excludeWatched: Boolean = false
    ): [Movie!]!

    """
    Returns a structured summary of user reviews for a given movie, computed
    server-side from the underlying review corpus (integer scores from 1 to 10
    plus free-text comments). The summary always comes back as a non-null
    `MovieReviewSummary`; an unknown movie id produces a NOT_FOUND error
    instead of a null result, so null cannot be confused with a bad id.

    When there are fewer than three reviews, the system has insufficient
    material to produce a meaningful prose synthesis, and `summary` is null;
    `reviewCount` still reports the exact number of reviews so the agent can
    distinguish "no reviews exist" from "too few reviews to summarize" by
    inspecting the result shape instead of guessing from a null summary
    alone. `averageScore` is null only when there are zero reviews, since
    a mean needs at least one score to report.
    """
    summarizeMovieReviews(
        """
        The id of the movie whose reviews should be summarized. Must reference
        an existing movie; unknown ids produce a NOT_FOUND error instead of a
        null result, so this field never returns null.
        """
        movieId: ID!
    ): MovieReviewSummary!
}

"""Union of Movie and Person for cross-type search"""
union SearchResult = Movie | Person | TvShow

"""Something watchable: the fields a Movie and a TV show have in common."""
interface Content {
    """The title's display name as stored in the catalog."""
    title: String!
    """The single primary genre the catalog tracks. Null when unclassified."""
    genre: Genre
    """The catalog's stored average rating, 0.0 to 10.0. Null means "no data on record," not "rated zero"."""
    rating: Float
    """URL of the poster image. Null when no poster is recorded."""
    posterUrl: String
}

"""
A movie in the catalog. Movies are the central entity of the system and the
unit most other operations resolve against. Catalog data is seeded from
The Movie Database (TMDB); live TMDB signals surface only through
`communityRating`.
"""
type Movie implements Content {
    """
    The catalog's own stable numeric identifier for this movie. Safe to cache
    and to pass back into other operations. Not the TMDB identifier; that is
    `tmdbId`.
    """
    id: ID!

    """The movie's display title as stored in the catalog."""
    title: String!

    """
    The four-digit year of the movie's release as recorded in the catalog.
    Write-time validation bounds it to 1888-2100; a year in the future means
    the catalog recorded an announced release and should be treated as
    provisional, since release dates slip.
    """
    releaseYear: Int!

    """
    The single primary genre the catalog tracks for this movie. Most films
    span several genres; this is the one the catalog chose to surface, not
    the only one that applies. Null when the title has not been classified.
    """
    genre: Genre

    """
    The catalog's stored average rating, from 0.0 to 10.0 inclusive. Kept for
    compatibility with clients reading `rating` through the `Content`
    interface; new selections should read `averageRating` instead.
    """
    rating: Float @deprecated(reason: "Use averageRating instead.")

    """
    The catalog's stored average rating for this movie, from 0.0 to 10.0
    inclusive, captured when the title entered the catalog. Null when the
    catalog has no rating on record, which is "no data," not "rated zero"
    and not "a bad movie." For a live community score fetched from TMDB at
    request time, read `communityRating` instead.
    """
    averageRating: Float

    """Runtime in minutes. Null when the catalog does not know it."""
    runtime: Int

    """Short plot synopsis. Null when none is recorded."""
    plot: String

    """URL of the poster image. Null when no poster is recorded."""
    posterUrl: String

    """
    The Movie Database (TMDB) external identifier. Null when the title has
    no TMDB link, in which case `communityRating` is also null.
    """
    tmdbId: Int

    """
    Live community rating fetched from TMDB at request time; the freshest
    audience signal available, distinct from `averageRating`, the catalog's
    stored figure. Null when the movie has no `tmdbId` or TMDB is
    unavailable; null never means "poorly rated."
    """
    communityRating: CommunityRating

    """
    The directors on record for this movie. An empty list means the catalog
    has no director recorded for the title, not that the film has none.
    """
    directors: [Person!]!

    """
    The cast on record: each entry links a person to the character they
    played. Empty when no cast has been recorded.
    """
    cast: [MovieCast!]!

    """
    User-submitted reviews for this movie, newest first. An empty list means
    no reviews exist; reviews are public and reading them requires no
    authentication. Each review carries an integer `score` from 1 to 10.
    """
    reviews: [Review!]!

    """
    Number of reviews on record for this movie. Always present; zero means
    no reviews exist.
    """
    reviewCount: Int!
}

enum Genre {
    ACTION
    COMEDY
    CRIME
    DRAMA
    FANTASY
    HORROR
    MYSTERY
    ROMANCE
    SCIFI
    THRILLER
    WAR
    WESTERN
}

enum MovieSortField {
    TITLE
    RELEASE_YEAR
    RATING
    RUNTIME
}

enum SortOrder {
    ASC
    DESC
}

input MovieFilter {
    genre: Genre
    minRating: Float
    maxRating: Float
    minYear: Int
    maxYear: Int
    """Only include movies at least this many minutes long. Movies with an unknown runtime are excluded when this is set."""
    minRuntime: Int
    """Only include movies at most this many minutes long. Movies with an unknown runtime are excluded when this is set."""
    maxRuntime: Int
    titleContains: String
}

input MovieSort {
    field: MovieSortField
    order: SortOrder
}

type MoviePage {
    content: [Movie!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
    isFirst: Boolean!
    isLast: Boolean!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

"""A page of people"""
type PersonPage {
    content: [Person!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
}

type Person {
    id: ID!
    name: String!
    birthYear: Int
    """Short biography blurb"""
    biography: String
    """Portrait image URL (TMDB)"""
    photoUrl: String
    """ISO 3166-1 alpha-2 country code"""
    countryCode: CountryCode
    """Country details resolved live from the external countries GraphQL API"""
    country: Country
    """Movies this person directed"""
    directedMovies: [Movie!]!
    """This person's acting credits in movies"""
    movieCastCredits: [MovieCast!]!
    """TV shows this person created"""
    createdShows: [TvShow!]!
    """This person's acting credits in TV shows"""
    tvShowCastCredits: [TvShowCast!]!
}


type MovieCast {
    id: ID!
    characterName: String!
    person: Person!
    movie: Movie!
}

type Country {
    "ISO 3166-1 alpha-2 code, e.g. CZ"
    code: ID!
    name: String!
    emoji: String
    capital: String
    currency: String
}

"""A movie search result from TMDB (The Movie Database)"""
type TmdbResult {
    tmdbId: Int!
    title: String!
    releaseYear: Int
    overview: String
    posterUrl: String
    """TMDB community vote average on a 0-10 scale"""
    rating: Float
}

type CommunityRating {
    """Vote average on a 0-10 scale"""
    voteAverage: Float!
    voteCount: Int!
}

type AuthResponse {
    token: String!
    user: User!
}

type User {
    id: ID!
    username: String!
    email: String
    role: Role!
}

enum Role {
    USER,
    ADMIN
}

type Mutation {
    deleteMovie(id: ID!): DeleteMovieResponse!
    "Deletes a person. With force: true, all movie/TV credits are unlinked first; otherwise a linked person yields a structured error."
    deletePerson(id: ID!, force: Boolean! = false): DeletePersonResponse!
    createMovie(input: CreateMovieInput!): Movie!
    updateMovie(input: UpdateMovieInput!): Movie!
    createPerson(input: CreatePersonInput!): Person!
    updatePerson(input: UpdatePersonInput!): Person!
    login(input: LoginInput!): AuthResponse!
    """Create a new USER account and sign in immediately"""
    register(input: RegisterInput!): AuthResponse!

    """Submit a review for a movie or TV show (one per user per title)"""
    createReview(input: CreateReviewInput!): Review!
    """Delete a review (owner or admin only)"""
    deleteReview(id: ID!): DeleteReviewResponse!

    """
    Adds a movie or TV show to the signed-in user's watch list and returns the
    created entry.

    Duplicate contract: each user can hold a given title at most once, enforced
    by the database. Calling this for a title already on the list changes
    nothing and fails with a BAD_REQUEST error whose message says the title is
    already in the watch list. Agents should treat that specific error as
    confirmation that the goal state already holds, not as a failure to report
    or retry.

    When `status` is omitted, the entry is created as WANT_TO_WATCH.
    """
    addToWatchlist(
        """
        The title to add. The input is @oneOf: provide exactly one of `movieId`
        or `tvShowId`, enforced by the type system before any resolver runs.
        """
        subject: WatchlistSubjectInput!,
        """Initial status for the new entry. Defaults to WANT_TO_WATCH when omitted."""
        status: WatchStatus
    ): WatchlistItem!
    """Change a watch-list entry's status, e.g. mark it watched."""
    setWatchStatus(itemId: ID!, status: WatchStatus!): WatchlistItem!
    """Remove an entry from the watch list."""
    removeFromWatchlist(itemId: ID!): Boolean!
}


input LoginInput {
    username: String!
    password: String!
}

"""Input for creating an account; field rules enforced by validation directives"""
input RegisterInput {
    username: String! @Size(min: 3, max: 50)
    email: String! @Size(max: 120) @Pattern(regexp: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
    password: String! @Size(min: 6, max: 100)
}

"""Result of deleting a movie."""
type DeleteMovieResponse {
    success: Boolean!
    message: String!
    """ID of the deleted movie, or null if nothing was deleted."""
    deletedId: ID
}

type DeletePersonResponse {
    success: Boolean!
    error: DeletePersonError
    deletedId: ID
}

enum DeletePersonError {
    LINKED_TO_MOVIE
    LINKED_TO_TV_SHOW
}

"""Input for creating a movie."""
input CreateMovieInput {
    title: String! @Size(min: 1, max: 200)
    releaseYear: Int! @Range(min: 1888, max: 2100)
    genre: Genre!
    """Rating from 0.0 to 10.0"""
    rating: Float @Range(min: 0, max: 10)
    """Runtime in minutes"""
    runtime: Int @Range(min: 1, max: 600)
    plot: String @Size(max: 2000)
    posterUrl: String @Size(max: 500)
    tmdbId: Int
}

"""Input for updating a movie; omitted fields are left unchanged."""
input UpdateMovieInput {
    id: ID!
    title: String @Size(min: 1, max: 200)
    releaseYear: Int @Range(min: 1888, max: 2100)
    genre: Genre
    """Rating from 0.0 to 10.0"""
    rating: Float @Range(min: 0, max: 10)
    """Runtime in minutes"""
    runtime: Int @Range(min: 1, max: 600)
    plot: String @Size(max: 2000)
    posterUrl: String @Size(max: 500)
    tmdbId: Int
}

input UpdatePersonInput {
    id: ID!
    name: String
    birthYear: Int
    countryCode: CountryCode
}

input CreatePersonInput {
    name: String!
    birthYear: Int
    countryCode: CountryCode
}

"""A television show"""
type TvShow implements Content {
    id: ID!
    title: String!
    genre: Genre
    "Average rating on a scale of 0-10"
    rating: Float
    posterUrl: String
    startYear: Int!
    "Null while the show is still airing"
    endYear: Int
    seasons: Int
    plot: String
    creators: [Person!]!
    cast: [TvShowCast!]!
    episodes: [Episode!]!
    reviews: [Review!]!
}

"""A single episode of a TV show"""
type Episode {
    id: ID!
    seasonNumber: Int!
    episodeNumber: Int!
    title: String!
    overview: String
    "Runtime in minutes"
    runtime: Int
    airYear: Int
}

"""An actor's role in a TV show, linking a person to a character"""
type TvShowCast {
    id: ID!
    characterName: String!
    person: Person!
    tvShow: TvShow!
}

"""A page of TV shows"""
type TvShowPage {
    content: [TvShow!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
}

"""A single entry in a user's watch list: a movie or a show, plus its status."""
type WatchlistItem {
    """The entry's own identifier, distinct from the movie or show it points at. Pass this to setWatchStatus and removeFromWatchlist."""
    id: ID!
    """The saved title, movie or TV show, exposed through the shared Content interface."""
    content: Content!
    """Where the entry stands: still planned (WANT_TO_WATCH) or already seen (WATCHED)."""
    status: WatchStatus!
}

"""Lifecycle status of a watch-list entry."""
enum WatchStatus {
    """On the list, not yet seen. The default for new entries."""
    WANT_TO_WATCH
    """The user has seen it; the entry remains on the list as a record rather than a plan."""
    WATCHED
}

"""Identifies the title to add. @oneOf: provide exactly one of movieId or tvShowId."""
input WatchlistSubjectInput @oneOf {
    movieId: ID
    tvShowId: ID
}

"""A user's review of a movie or TV show"""
type Review {
    id: ID!
    """Rating from 1 to 10"""
    score: Int!
    comment: String
    createdAt: DateTime!
    user: User!
}

type Subscription {
    """Live notifications when reviews are posted, pushed over WebSocket. Optionally filter by movieId or tvShowId."""
    reviewAdded(movieId: ID, tvShowId: ID): ReviewNotification!
}

"""Notification pushed to subscribers when a review is created"""
type ReviewNotification {
    review: Review!
    """Set when the review targets a movie"""
    movieId: ID
    """Set when the review targets a TV show"""
    tvShowId: ID
    """Title of the reviewed movie or show"""
    title: String!
}

"""
The review target. @oneOf makes this an input union: exactly one of the
fields must be provided, enforced by GraphQL itself before any resolver runs.
"""
input ReviewSubjectInput @oneOf {
    movieId: ID
    tvShowId: ID
}

"""Input for creating a review of a movie or TV show"""
input CreateReviewInput {
    subject: ReviewSubjectInput!
    """Rating from 1 to 10"""
    score: Int! @Range(min: 1, max: 10)
    comment: String @Size(max: 2000)
}

"""Result of deleting a review."""
type DeleteReviewResponse {
    success: Boolean!
    """ID of the deleted review, or null if nothing was deleted."""
    deletedId: ID
}

# ---------------------------------------------------------------------------
# Agent-facing operations (GraphQL + MCP tutorial, Class 2)
# ---------------------------------------------------------------------------

"""
Available mood categories. Bounded by design so an agent cannot supply
free-text moods that would force fuzzy matching on the server. Add a
new value here and update the recommendation engine in the same change;
unannotated values are a maintenance hazard.
"""
enum Mood {
    """
    Familiar, low-stakes films the viewer has likely seen before and would
    watch again on a rainy Sunday. Warm tone, broad humor, predictable
    resolutions. The "rainy Sunday" mood.
    """
    COMFORT,

    """High-energy action, exploration, or quest arcs. Propulsive pacing, clear stakes. Pure fear belongs to HORROR."""
    ADVENTURE,

    """Films whose spine is a romantic relationship, regardless of surrounding genre. Excludes films where romance is only a subplot."""
    ROMANCE,

    """Films aiming to frighten through atmosphere, suspense, or shock. Includes psychological and supernatural horror. Investigative thrillers belong elsewhere."""
    HORROR,

    """
    Films that reward attention and reflection: character studies, slow
    cinema, philosophical science fiction, morally ambiguous dramas. Expect
    a longer post-watch conversation than COMFORT; pick this when the user
    wants something to think about, not unwind to.
    """
    THOUGHTFUL,

    """Films whose primary aim is laughter. Spans broad, romantic, satirical, and absurdist comedy. Excludes dramas with comic relief."""
    COMEDY
}

"""
A server-computed snapshot of a movie's review corpus, built around a short
prose synthesis instead of a sentiment label.
"""
type MovieReviewSummary {
    """The id of the summarized movie, echoing the operation's argument."""
    movieId: ID!
    """Number of reviews the summary was computed from. Zero means no reviews exist."""
    reviewCount: Int!
    """A short prose synthesis of what reviewers said. Null when there are fewer than three reviews; read reviewCount to see how many there were."""
    summary: String
    """Recurring themes pulled from the review text. Empty when reviewCount is zero or when none were identified."""
    themes: [String!]!
    """Mean of the 1-to-10 review scores. Null only when reviewCount is zero."""
    averageScore: Float
}
